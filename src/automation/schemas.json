{
  "create_monster": {
    "description": "Create a complete monster statblock, bestiary note and image-backed reusable creature token. The image must already exist in the vault.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "statblock": {
          "type": "object",
          "properties": {
            "size": {
              "enum": [
                "tiny",
                "small",
                "medium",
                "large",
                "huge",
                "gargantuan",
                "Tiny",
                "Small",
                "Medium",
                "Large",
                "Huge",
                "Gargantuan"
              ]
            },
            "creatureType": {
              "type": "string",
              "minLength": 1
            },
            "subtype": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "alignment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "ac": {
              "type": "integer",
              "minimum": 1
            },
            "hp": {
              "type": "integer",
              "minimum": 1
            },
            "hitDice": {
              "type": "string",
              "minLength": 1
            },
            "speed": {
              "type": "string",
              "minLength": 1
            },
            "stats": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "minItems": 6,
              "maxItems": 6
            },
            "cr": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9]|[12][0-9]|30|1/[248])$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30
                },
                {
                  "enum": [
                    0.125,
                    0.25,
                    0.5
                  ]
                }
              ]
            },
            "saves": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "skillsaves": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "damageVulnerabilities": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "damageResistances": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "damageImmunities": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "conditionImmunities": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "senses": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "languages": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "desc": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "name",
                  "desc"
                ],
                "additionalProperties": false
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "desc": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "name",
                  "desc"
                ],
                "additionalProperties": false
              }
            },
            "bonusActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "desc": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "name",
                  "desc"
                ],
                "additionalProperties": false
              }
            },
            "reactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "desc": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "name",
                  "desc"
                ],
                "additionalProperties": false
              }
            },
            "legendaryActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "desc": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "name",
                  "desc"
                ],
                "additionalProperties": false
              }
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            }
          },
          "required": [
            "size",
            "creatureType",
            "ac",
            "hp",
            "speed",
            "stats",
            "cr"
          ],
          "additionalProperties": false
        },
        "token": {
          "type": "object",
          "properties": {
            "imagePath": {
              "type": "string",
              "minLength": 1
            },
            "imageFit": {
              "enum": [
                "cover",
                "contain"
              ]
            },
            "icon": {
              "type": "string",
              "maxLength": 32
            },
            "backgroundColor": {
              "type": "string",
              "minLength": 1
            },
            "borderColor": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "imagePath"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "name",
        "statblock",
        "token"
      ],
      "additionalProperties": false
    }
  },

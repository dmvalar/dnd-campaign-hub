  "create_adventure": {
    "description": "Create a campaign adventure folder note using the current plugin template.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "levelFrom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "levelTo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "expectedSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "create_scene": {
    "description": "Create a numbered scene in an explicit campaign adventure. Existing scene numbers are never renumbered by this operation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "adventurePath": {
          "anyOf": [
            {
              "type": "string",
              "description": "Full vault-relative Markdown path including .md"
            },
            {
              "type": "object",
              "properties": {
                "$ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9]*$"
                }
              },
              "required": [
                "$ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sceneNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "act": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "sceneType": {
          "enum": [
            "combat",
            "exploration",
            "social",
            "puzzle",
            "montage"
          ]
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "deadly"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "npcPaths": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "description": "Full vault-relative Markdown path including .md"
              },
              {
                "type": "object",
                "properties": {
                  "$ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9]*$"
                  }
                },
                "required": [
                  "$ref"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "mapPaths": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "description": "Full vault-relative Markdown path including .md"
              },
              {
                "type": "object",
                "properties": {
                  "$ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9]*$"
                  }
                },
                "required": [
                  "$ref"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "name",
        "adventurePath",
        "sceneNumber"
      ],
      "additionalProperties": false
    }
  },
  "create_encounter": {
    "description": "Create a launchable encounter from existing or preceding staged creature/NPC statblocks, with calculated difficulty and optional linked scene/selected party.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scenePath": {
          "anyOf": [
            {
              "type": "string",
              "description": "Full vault-relative Markdown path including .md"
            },
            {
              "type": "object",
              "properties": {
                "$ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9]*$"
                }
              },
              "required": [
                "$ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "adventurePath": {
          "anyOf": [
            {
              "type": "string",
              "description": "Full vault-relative Markdown path including .md"
            },
            {
              "type": "object",
              "properties": {
                "$ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9]*$"
                }
              },
              "required": [
                "$ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "creatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Full vault-relative Markdown path including .md"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "$ref": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9]*$"
                      }
                    },
                    "required": [
                      "$ref"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "initiative": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              },
              "currentHp": {
                "type": "integer",
                "minimum": 0
              },
              "thp": {
                "type": "integer",
                "minimum": 0
              },
              "friendly": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "includeParty": {
          "type": "boolean",
          "default": false
        },
        "selectedPartyId": {
          "type": "string",
          "minLength": 1
        },
        "selectedPartyMembers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "name",
        "creatures"
      ],
      "additionalProperties": false
    }
  },
  "create_map": {
    "description": "Create a native map annotation record and map note using an existing vault raster image. Provide both width/height if automatic image dimensions are unavailable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "imagePath": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "battlemap",
            "regional",
            "world"
          ]
        },
        "gridType": {
          "enum": [
            "square",
            "hex-horizontal",
            "hex-vertical",
            "none"
          ]
        },
        "gridSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "scaleValue": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000000
        },
        "scaleUnit": {
          "enum": [
            "feet",
            "miles",
            "km"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "name",
        "imagePath"
      ],
      "additionalProperties": false
    }
  },
